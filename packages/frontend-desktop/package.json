{
  "name": "@miya-dairy/frontend-desktop",
  "version": "1.0.0",
  "description": "Miya Dairy Desktop App for macOS",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && electron .",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "package": "electron-builder --mac",
    "package:arm64": "electron-builder --mac --arm64",
    "package:x64": "electron-builder --mac --x64"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron": "^28.3.3",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@miya-dairy/shared": "*",
    "@types/node": "^18.19.130",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron-builder": "^24.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0"
  },
  "build": {
    "appId": "com.miyadairy.desktop",
    "productName": "Miya Dairy",
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
