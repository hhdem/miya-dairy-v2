miya.im www.miya.im {
    tls lukelukewe@gmail.com

    # 使用 route 确保路由按顺序评估
    route {
        # 后端 API - 必须在最前面
        reverse_proxy /api/* miya-dairy-backend:3000

        # 上传文件
        handle /uploads/* {
            root * /srv
            file_server
        }

        # 管理后台
        handle_path /admin/* {
            root * /srv/admin
            try_files {path} /index.html
            file_server
        }

        # 公共前端（带 /public 前缀）
        handle_path /public/* {
            root * /srv/public
            try_files {path} /index.html
            file_server
        }

        # 根路径 - 重定向到 /public/
        redir / /public/ permanent

        # 其他路径 - 提供公共前端（fallback）
        handle {
            root * /srv/public
            try_files {path} /index.html
            file_server
        }
    }
}

# 可选：配置 ACME 使用 DNS 挑战（如果 HTTP 挑战不可用）
# {
#     acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
# }

